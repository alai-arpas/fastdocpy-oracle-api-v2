# Valori non sensibili. Le credenziali restano in .secrets/.
FDP_ORACLE__HOST=your-oracle-host.arpas.adds
FDP_ORACLE__PORT=1521
FDP_ORACLE__SERVICE_NAME=your_service_name

# Database ADB di destinazione (sincronizzazione verso WKSP_DBPOA).
# DSN gia' pronta (non host/porta/service separati), come nel legacy.
FDP_ADB__DSN=your-adb-connect-descriptor
